# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Must be a verified Resend sender, e.g. BIWS Website <contact@your-domain.com>
RESEND_FROM_EMAIL=BIWS Website <onboarding@resend.dev>

# Inbox that should receive contact form submissions
CONTACT_RECIPIENT_EMAIL=info@beguminayat.com

# WhatsApp number in international format without '+' (e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=923009866629
